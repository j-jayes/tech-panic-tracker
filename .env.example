# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Setup commands for each of these live in docs/infrastructure.md.

# Gemini API — LLM-assisted detection and extraction (DR-005).
# Created on GCP project jonathanjayes-com, restricted to the Generative Language API.
GEMINI_API_KEY=

# OSF personal access token — project creation and preregistration (osf.io/settings/tokens).
# Scope: osf.full_write. Not yet created; see docs/infrastructure.md §5.
OSF_TOKEN=

# Archive and outcome-data API keys — registration URLs in docs/research/archives-and-apis.md
# and docs/research/outcome-data-inventory.md. Add each as it is registered.
GOVINFO_API_KEY=
CONGRESS_GOV_API_KEY=
TROVE_API_KEY=
FRED_API_KEY=
NYT_API_KEY=
IPUMS_API_KEY=
BLS_API_KEY=
OPEN_ROUTER_KEY=                # OpenRouter; used only by analysis/pilot-draft/benchmark/ (multi-model extraction benchmark)
